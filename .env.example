# Copy to .env and adjust. Never commit .env.

# --- Postgres (used by the db service and to build DATABASE_URL) ---
POSTGRES_USER=ava
POSTGRES_PASSWORD=ava
POSTGRES_DB=ava
POSTGRES_PORT=5432

# --- Published ports on the host ---
API_PORT=8000
WEB_PORT=5173
REDIS_PORT=6379

# --- Backend ---
# Inside Compose these are overridden to point at the db/redis services.
DATABASE_URL=postgresql+psycopg://ava:ava@localhost:5432/ava
REDIS_URL=redis://localhost:6379/0
ENV=dev
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# --- Auth ---
JWT_SECRET=change-me-in-dev-and-use-a-real-secret-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Signing keys (Ed25519, one PEM per institution code) ---
KEYS_DIR=/keys

# --- Uploads ---
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_MB=10
UPLOAD_RETENTION_DAYS=7

# --- Issued certificate PDFs (generated once, served as stored) ---
ISSUED_DIR=/data/uploads/certificates

# --- CSV import (POST /certificates/import) ---
IMPORT_MAX_ROWS=5000
IMPORT_MAX_MB=2

# --- Verification thresholds (tune on the test set) ---
OCR_MIN_FIELD_CONFIDENCE=0.85
NAME_MATCH_THRESHOLD=90
NAME_CONFLICT_THRESHOLD=75

# --- Share links ---
SHARE_LINK_TTL_HOURS=72

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
