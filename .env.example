# Copy to .env and adjust. Never commit .env.

# --- Postgres (used by the db service and to build DATABASE_URL) ---
POSTGRES_USER=ava
POSTGRES_PASSWORD=ava
POSTGRES_DB=ava
POSTGRES_PORT=5432

# --- Published ports on the host ---
API_PORT=8000
WEB_PORT=5173
REDIS_PORT=6379

# --- Backend ---
# Inside Compose these are overridden to point at the db/redis services.
DATABASE_URL=postgresql+psycopg://ava:ava@localhost:5432/ava
REDIS_URL=redis://localhost:6379/0
ENV=dev
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# --- Auth ---
JWT_SECRET=change-me-in-dev-and-use-a-real-secret-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Signing keys (Ed25519, one PEM per institution code) ---
KEYS_DIR=/keys

# --- Uploads ---
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_MB=10
UPLOAD_RETENTION_DAYS=7

# --- Issued certificate PDFs (generated once, served as stored) ---
ISSUED_DIR=/data/uploads/certificates

# --- CSV import (POST /certificates/import) ---
IMPORT_MAX_ROWS=5000
IMPORT_MAX_MB=2

# --- Verification thresholds (tune on the test set) ---
# >= MIN_FIELD: a differing field is a conflict (MISMATCH).
# >= DISCREPANCY and < MIN_FIELD: a possible discrepancy (blocks VERIFIED).
# < DISCREPANCY: the field counts as not read.
OCR_MIN_FIELD_CONFIDENCE=0.85
OCR_DISCREPANCY_CONFIDENCE=0.50
# A valid QR (or an exact certificate number) verifies an uploaded document
# only if its student name was read and matched and at least this many
# critical fields match. Below it the result is MANUAL_REVIEW, "Unconfirmed".
QR_MIN_MATCHED_FIELDS=3
NAME_MATCH_THRESHOLD=90
NAME_CONFLICT_THRESHOLD=75

# --- Share links ---
SHARE_LINK_TTL_HOURS=72

# --- Frontend ---
# The app calls the API at a relative /api/v1; the Vite dev server proxies
# /api to this target, so only WEB_PORT has to be reachable from outside.
API_PROXY_TARGET=http://api:8000
# Optional escape hatch: an absolute URL here bypasses the proxy, and the
# API's CORS_ORIGINS must then list the web origin.
# VITE_API_BASE_URL=
